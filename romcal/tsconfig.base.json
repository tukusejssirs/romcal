{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "baseUrl": ".",
    "paths": {
      "@romcal/calendars": ["libs/calendars/src/index.ts"],
      "@romcal/core": ["libs/core/src/index.ts"],
      "@romcal/locales": ["libs/locales/src/index.ts"],
      "@romcal/metadata": ["libs/metadata/src/index.ts"],
      "@romcal/types": ["libs/types/src/index.ts"],
      "@romcal/utils": ["libs/utils/src/index.ts"]
    }
  }
}
