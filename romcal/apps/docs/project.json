{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "docs",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "tags": ["scope:docs", "type:app", "platform:web"],
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": ["generate-version"],
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vitepress build apps/docs/src"],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist/apps/docs"],
      "configurations": {
        "production": {
          "commands": ["tsx tools/scripts/generate-version-info.ts apps/docs", "vitepress build apps/docs/src"]
        }
      }
    },
    "generate-version": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/scripts/generate-version-info.ts apps/docs",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/apps/docs/src/version.constant.ts"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress dev apps/docs/src"
      }
    },
    "lint:check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --config eslint.config.mjs",
        "cwd": "apps/docs"
      }
    },
    "lint:fix": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --fix . --config eslint.config.mjs",
        "cwd": "apps/docs"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress preview apps/docs/src"
      },
      "dependsOn": ["build"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress dev apps/docs/src"
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/docs"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest",
        "cwd": "apps/docs"
      }
    },
    "format:check": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier -c .",
        "cwd": "apps/docs"
      }
    },
    "format:fix": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier -w .",
        "cwd": "apps/docs"
      }
    },
    "check-links": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/scripts/check-broken-links.ts apps/docs/src",
        "cwd": "{workspaceRoot}"
      }
    },
    "sort-glossary": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/scripts/sort-glossary.ts",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "specific-file": {
          "command": "tsx tools/scripts/sort-glossary.ts {args.file}"
        }
      }
    }
  }
}
