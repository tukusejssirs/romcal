    "vite": "^6.0.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.0.0"
  },
  "nx": {
    "targets": {
      "format:check": {
        "cache": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "prettier -c . --ignore-path workspace.prettierignore"
        }
      },
      "format:fix": {
        "cache": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "prettier -w . --ignore-path workspace.prettierignore"
        }
      },
      "lint-staged": {
        "cache": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "lint-staged"
        }
      },
      "lint:check": {
        "cache": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint . --config eslint.workspace.config.mjs"
        }
      },
      "lint:fix": {
        "cache": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint --fix . --config eslint.workspace.config.mjs"
        }
      }
    }
  }
}
